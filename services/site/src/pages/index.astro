---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import CoProductRow from "../components/CoProductRow.astro";
import ProblemSection from "../components/ProblemSection.astro";
import IdeaSection from "../components/IdeaSection.astro";
import SubstrateWalkthrough from "../components/SubstrateWalkthrough.astro";
import TwoDoors from "../components/TwoDoors.astro";
import NotSection from "../components/NotSection.astro";
import BuiltSection from "../components/BuiltSection.astro";
import GetStartedTeaser from "../components/GetStartedTeaser.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Minsky — the engineering organization around your AI agents";
const description =
  "AI agents can write the code; Minsky is the engineering organization around them — isolated workspaces, adversarial review, durable memory, and decision routing, built into the environment.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <CoProductRow />
    <ProblemSection />
    <IdeaSection />
    <SubstrateWalkthrough />
    <TwoDoors />
    <NotSection />
    <BuiltSection />
    <GetStartedTeaser />
  </main>
  <SiteFooter />
</BaseLayout>
