---
// Preview variant C — full home-page render for the v2 restructure.
// Does not affect the live home page (src/pages/index.astro).
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import ProblemSectionV2 from "../../components/ProblemSectionV2.astro";
import IdeaSectionV2 from "../../components/IdeaSectionV2.astro";
import TwoDoorsV2 from "../../components/TwoDoorsV2.astro";
import SubstrateWalkthroughV2 from "../../components/SubstrateWalkthroughV2.astro";
import NotSection from "../../components/NotSection.astro";
import BuiltSection from "../../components/BuiltSection.astro";
import GetStartedTeaser from "../../components/GetStartedTeaser.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PreviewBanner from "../../components/PreviewBanner.astro";

const title = "Preview variant C — Minsky";
const description = "Preview variant C of the Minsky home-page restructure. Not published.";
---

<BaseLayout title={title} description={description} pathname="/preview/c" noindex={true}>
  <PreviewBanner variant="C" />
  <Header />
  <main>
    <Hero
      headline="The organization is the missing layer. Minsky builds it into your environment."
      subheadline="Isolated workspaces, adversarial review, durable memory, decision routing — the structure agents lack, enforced where they work."
    />
    <ProblemSectionV2 />
    <IdeaSectionV2 />
    <TwoDoorsV2 />
    <SubstrateWalkthroughV2 />
    <NotSection />
    <BuiltSection />
    <GetStartedTeaser />
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  :global(body) {
    padding-top: 2.25rem;
  }
</style>
