---
// Preview index — links to the three home-page restructure variants
// plus the companion essay. The live home page is unchanged; nothing
// under /preview is published or promoted yet.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const title = "Preview — Minsky";
const description =
  "Side-by-side preview of three hero variants for the Minsky home-page restructure.";

const variants = [
  {
    label: "Variant A",
    href: "/preview/a",
    summary:
      "Headline: \"Engineering's shifting left.\" Subheadline frames the shift as the organization moving upstream of the code, in general terms.",
  },
  {
    label: "Variant B",
    href: "/preview/b",
    summary:
      "Same headline as A. Subheadline names Minsky directly as the thing doing the moving, and closes on \"at every scale.\"",
  },
  {
    label: "Variant C",
    href: "/preview/c",
    summary:
      "Different headline: \"The organization is the missing layer. Minsky builds it into your environment.\" Subheadline drops straight into the four primitives.",
  },
];
---

<BaseLayout title={title} description={description} pathname="/preview" noindex={true}>
  <Header />
  <main>
    <section class="page">
      <div class="page-inner">
        <p class="eyebrow">Preview</p>
        <h1 class="page-headline">Three home-page variants, compared.</h1>
        <p class="page-lead">
          The live home page is unchanged while these render side by side — nothing here is
          published. Each variant shares the same restructured body: a stat-row problem
          section, a tightened idea section, the two doors moved ahead of the walkthrough, and
          a link out to the full essay. Only the hero copy differs between them. The pick
          happens first; a later phase promotes the chosen variant to the live home page.
        </p>

        <h2 class="section-title">The variants</h2>
        <ul class="variant-list">
          {
            variants.map((v) => (
              <li class="variant-item">
                <a class="variant-link" href={v.href}>
                  {v.label}
                </a>
                <p class="variant-summary">{v.summary}</p>
              </li>
            ))
          }
        </ul>

        <h2 class="section-title">The essay</h2>
        <p class="section-body">
          The idea section and both doors on every variant link out to the full argument behind
          the restructure.
        </p>
        <p>
          <a class="text-link" href="/structure-gap">Read the essay →</a>
        </p>
        <p class="section-body">Title options still under consideration:</p>
        <ul class="title-options">
          <li>The structure gap</li>
          <li>Closing the structure gap</li>
          <li>Structure that holds when you look away</li>
        </ul>

        <div class="page-cta-row">
          <a class="text-link" href="/">Back to the live home page</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .page {
    padding: 4.5rem 1.5rem 5rem;
  }
  .page-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .page-headline {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .page-lead {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
    max-width: 42rem;
  }

  .section-title {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin: 1.5rem 0 0;
  }
  .section-body {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0.25rem 0 0;
    max-width: 40rem;
  }

  .variant-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .variant-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid color-mix(in oklch, var(--color-text-primary) 8%, transparent);
    border-radius: 6px;
    background-color: var(--color-bg-elevated);
  }
  .variant-link {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--color-signal);
    letter-spacing: 0.01em;
    transition: color 160ms ease;
  }
  .variant-link:hover {
    color: var(--color-text-primary);
  }
  .variant-summary {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  .title-options {
    margin: 0.25rem 0 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .title-options li {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  .page-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in oklch, var(--color-text-primary) 6%, transparent);
  }
  .text-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-signal);
    letter-spacing: 0.01em;
    transition: color 160ms ease;
  }
  .text-link:hover {
    color: var(--color-text-primary);
  }
</style>
