---
// What it is, concretely — section 4 of the home-page skeleton (mt#3827).
// Eight real product surfaces, walked through UNDER an explanatory intro,
// not instead of it. Copy is plain language — no undefined register terms.
import SubstrateScene from "./SubstrateScene.astro";
import scene01SessionCli from "../assets/screenshots/scene-01-session-cli.png";
import scene03CockpitHome from "../assets/screenshots/scene-03-cockpit-home.png";
import scene04ReviewGithub from "../assets/screenshots/scene-04-review-github.png";
import scene05TaskGraph from "../assets/screenshots/scene-05-task-graph.png";
import scene06Memory from "../assets/screenshots/scene-06-memory.png";
import scene07HookDenial from "../assets/screenshots/scene-07-hook-denial.png";
import scene08Asks from "../assets/screenshots/scene-08-asks.png";

/*
 * Eight scenes. Scene 02 (a tool call surfaced through a harness) has no
 * clean live-capture path yet — a plain placeholder stands in via
 * SubstrateScene's undefined-screenshot branch (no leaked task IDs or
 * internal process language; see mt#3827).
 */
const scenes = [
  {
    eyebrow: "Sessions",
    title: "Sessions that isolate.",
    body: "Each task gets its own workspace — its own branch, its own file scope, run separately from everything else in flight. An agent never edits shared code directly, so a stalled or wrong session can't corrupt anyone else's work.",
    screenshot: scene01SessionCli,
    screenshotAlt: "Real CLI output: starting and inspecting a task session",
  },
  {
    eyebrow: "Tools",
    title: "Tools that compose.",
    body: "The same commands work whether a person types them in a terminal or an agent calls them through a tool protocol. One set of operations, every harness — no separate API to keep in sync.",
    screenshot: undefined,
    screenshotAlt: "A tool call surfaced through a coding harness",
  },
  {
    eyebrow: "Cockpit",
    title: "Attention that allocates.",
    body: "The cockpit shows what's actually in flight: open tasks, open reviews, and the handful of questions that need a person to decide. Dense by design — built to be scanned, not admired.",
    screenshot: scene03CockpitHome,
    screenshotAlt: "The web cockpit showing tasks and reviews in flight",
  },
  {
    eyebrow: "Review",
    title: "Reviews that hold.",
    body: "Every change is reviewed by a separate agent, running a different model, with no stake in the code it's judging. A merge waits until that review comes back clean — the same gate whether a person or an agent wrote the change.",
    screenshot: scene04ReviewGithub,
    screenshotAlt: "An automated adversarial code review, approved on a real pull request",
  },
  {
    eyebrow: "Tasks",
    title: "Tasks that converge.",
    body: "Large pieces of work break into smaller tasks with real dependencies between them — not a flat list, a graph. The system tracks which tasks are blocked on which, so nothing merges out of order by accident.",
    screenshot: scene05TaskGraph,
    screenshotAlt: "A task dependency graph with parent and child tasks",
  },
  {
    eyebrow: "Memory",
    title: "Memory that compounds.",
    body: "When something goes wrong once and gets diagnosed, that lesson is saved and comes back automatically the next time it's relevant — to any agent, in any session. The same mistake doesn't get made twice for lack of a shared memory.",
    screenshot: scene06Memory,
    screenshotAlt: "Searching recorded lessons in the memory store",
  },
  {
    eyebrow: "Hooks",
    title: "Hooks that catch.",
    body: "Some rules are enforced in the code path itself: a formatting violation, an unsafe command, a merge without review — blocked before it happens, not flagged after. The same block applies whether the commit came from a person or an agent.",
    screenshot: scene07HookDenial,
    screenshotAlt: "A pre-commit check blocking a change before it can land",
  },
  {
    eyebrow: "Decisions",
    title: "Decisions that surface.",
    body: "Some choices genuinely need a person — naming something, changing scope, taking on risk. Instead of guessing, Minsky packages the question with the context needed to answer it and routes it to whoever owns that decision, then keeps moving on everything else.",
    screenshot: scene08Asks,
    screenshotAlt: "A queue of decisions routed to a person, each with its own context",
  },
];
---

<section id="how-it-works" aria-labelledby="how-it-works-heading">
  <header class="substrate-header">
    <div class="substrate-header-inner">
      <p class="eyebrow">What it is, concretely</p>
      <h2 id="how-it-works-heading" class="substrate-headline">
        Eight surfaces, one environment.
      </h2>
      <p class="substrate-sub">
        Minsky is a CLI, an MCP server, and a web cockpit, all reading and writing the same
        underlying state. What follows is eight of its real surfaces, each doing one piece of
        the coordination work described above — not mockups, actual screenshots of a running
        system.
      </p>
    </div>
  </header>
  {
    scenes.map((s, i) => (
      <SubstrateScene
        eyebrow={s.eyebrow}
        title={s.title}
        body={s.body}
        screenshot={s.screenshot}
        screenshotAlt={s.screenshotAlt}
        reverse={i % 2 === 1}
      />
    ))
  }
</section>

<style>
  .substrate-header {
    padding: 5rem 1.5rem 2.5rem;
  }
  .substrate-header-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .substrate-headline {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .substrate-sub {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0;
  }
</style>
