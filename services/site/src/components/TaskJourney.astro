---
// Show — beat 3 of the six-beat reframe (mt#3838, Amendment 2).
//
// Replaces the eight-surface walkthrough, which sequenced the demo by
// Minsky's own architecture (Sessions, Tools, Cockpit, Review, ...) and
// read to every evaluation reader as eight abstract nouns describing the
// product to itself, each one a claim beside an unrelated screenshot.
//
// This follows a single task from filing to merged lesson. Scene titles
// name what happens to the task; each body picks up the state the
// previous scene left it in. Same captures, sequenced as one narrative.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import ProductFrame from "./ProductFrame.astro";
import scene01SessionCli from "../assets/screenshots/scene-01-session-cli.png";
import scene03CockpitHome from "../assets/screenshots/scene-03-cockpit-home.png";
import scene04ReviewGithub from "../assets/screenshots/scene-04-review-github.png";
import scene05TaskGraph from "../assets/screenshots/scene-05-task-graph.png";
import scene06Memory from "../assets/screenshots/scene-06-memory.png";
import scene07HookDenial from "../assets/screenshots/scene-07-hook-denial.png";
import scene08Asks from "../assets/screenshots/scene-08-asks.png";

interface Step {
  title: string;
  body: string;
  screenshot: ImageMetadata;
  screenshotAlt: string;
  chromeTitle: string;
  tone?: "native" | "foreign";
}

const steps: Step[] = [
  {
    title: "It starts as a task.",
    body: "You write down what should happen and what would make it correct. The task carries its own success criteria, and its dependencies on other work, so nothing downstream starts before the thing it needs has landed.",
    screenshot: scene05TaskGraph,
    screenshotAlt: "A task dependency graph with parent and child tasks",
    chromeTitle: "minsky · tasks",
  },
  {
    title: "It gets a workspace of its own.",
    body: "Nothing runs in your checkout. The task opens a session with its own clone, its own branch, and its own file scope. A session that stalls or goes wrong sits in its own corner and touches nothing else in flight.",
    screenshot: scene01SessionCli,
    screenshotAlt: "Real CLI output: starting and inspecting a task session",
    chromeTitle: "minsky · session",
  },
  {
    title: "The agent hits a wall you put there.",
    body: "Inside that workspace the agent works under the same hooks you do. A commit that skips formatting, an unsafe command, a merge without review: blocked at the moment of the action, rather than flagged afterward in a report nobody reads. The rule holds whether or not the agent remembers it.",
    screenshot: scene07HookDenial,
    screenshotAlt: "A pre-commit check blocking a change before it can land",
    chromeTitle: "minsky · hooks",
  },
  {
    title: "A model that didn't write it reviews it.",
    body: "The session opens a pull request in your repository, on GitHub, in the flow your team already uses. minsky-reviewer[bot] reads it with a different model and no implementer context: it did not write this code and has nothing invested in defending it. The merge gate holds until that review converges.",
    screenshot: scene04ReviewGithub,
    screenshotAlt: "An automated adversarial code review, approved on a real pull request",
    chromeTitle: "github.com",
    tone: "foreign",
  },
  {
    title: "The one decision that's actually yours arrives with its context.",
    body: "Some calls belong to a person: naming something, changing scope, accepting a risk. Instead of guessing, the session packages the question with what you need to answer it and routes it to you. Everything not blocked on your answer keeps moving while it waits.",
    screenshot: scene08Asks,
    screenshotAlt: "A queue of decisions routed to a person, each with its own context",
    chromeTitle: "minsky · asks",
  },
  {
    title: "The lesson outlives the session.",
    body: "Whatever went wrong here and got diagnosed is written down where the next session is handed it, for any agent, in any project, without you remembering to say it again.",
    screenshot: scene06Memory,
    screenshotAlt: "Searching recorded lessons in the memory store",
    chromeTitle: "minsky · memory",
  },
  {
    title: "And this was one task among many.",
    body: "The cockpit holds the picture that used to exist only in your head: what's in flight, what's blocked, and the short list actually waiting on you. This is the part that changes when the number of sessions goes from one to eight.",
    screenshot: scene03CockpitHome,
    screenshotAlt: "The web cockpit showing tasks and reviews in flight",
    chromeTitle: "minsky · cockpit",
  },
];
---

<section id="how-it-works" aria-labelledby="how-it-works-heading">
  <header class="journey-header">
    <div class="journey-header-inner">
      <p class="eyebrow">How it works</p>
      <h2 id="how-it-works-heading" class="journey-headline">
        Follow one task all the way through.
      </h2>
      <p class="journey-sub">
        Seven steps, in order, for a single piece of work: from the moment you
        file it to the moment its lesson is waiting for the next one. Every
        screen below is a capture of a running system rather than a mockup.
      </p>
    </div>
  </header>

  <ol class="journey-steps">
    {
      steps.map((s, i) => (
        <li class:list={["journey-step", i % 2 === 1 && "reverse"]}>
          <div class="step-grid">
            <div class="step-caption">
              <p class="step-index">
                <span class="step-number">{String(i + 1).padStart(2, "0")}</span>
                <span class="step-total">/ {String(steps.length).padStart(2, "0")}</span>
              </p>
              <h3 class="step-title">{s.title}</h3>
              <p class="step-body">{s.body}</p>
            </div>
            <div class="step-product">
              <ProductFrame chromeTitle={s.chromeTitle} tone={s.tone ?? "native"}>
                <Picture
                  src={s.screenshot}
                  alt={s.screenshotAlt}
                  formats={["avif", "webp"]}
                  fallbackFormat="png"
                  width={s.screenshot.width > 900 ? 900 : s.screenshot.width}
                  densities={[1]}
                  loading="lazy"
                />
              </ProductFrame>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .journey-header {
    padding: 5rem 1.5rem 2.5rem;
  }
  .journey-header-inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .journey-headline {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .journey-sub {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 36rem;
    margin: 0;
  }

  .journey-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .journey-step {
    padding: 3.5rem 1.5rem;
    border-bottom: 1px solid color-mix(in oklch, var(--color-text-primary) 4%, transparent);
  }
  .step-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .step-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 5rem;
    }
    .journey-step.reverse .step-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
    .journey-step.reverse .step-caption {
      order: 2;
    }
    .journey-step.reverse .step-product {
      order: 1;
    }
  }

  .step-caption {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .step-index {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: var(--text-eyebrow--letter-spacing);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }
  .step-number {
    color: var(--color-signal);
  }
  .step-total {
    color: var(--color-text-subtle);
  }
  .step-title {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .step-body {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 32rem;
    margin: 0;
  }

  .step-product :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
