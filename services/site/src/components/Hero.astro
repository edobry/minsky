---
import { Picture } from "astro:assets";
import CtaButton from "./CtaButton.astro";
import ProductFrame from "./ProductFrame.astro";
import heroImage from "../assets/screenshots/hero-session-lifecycle.png";

interface Props {
  /** Hero headline. Defaults to the live home-page copy. */
  headline?: string;
  /** Hero subheadline. Defaults to the live home-page copy. */
  subheadline?: string;
}

const {
  headline = "Software engineering isn't ending. It's moving into the environment.",
  subheadline = "AI agents can write the code; Minsky is the engineering organization around them — task tracking, isolated workspaces, adversarial review, durable memory, and decision routing, built into the environment itself.",
} = Astro.props;
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-caption">
      <p class="eyebrow">Minsky</p>
      <h1 class="hero-headline tracking-display">
        {headline}
      </h1>
      <p class="hero-sub">
        {subheadline}
      </p>
      <p class="hero-concrete">
        A CLI, an MCP server, and a web cockpit. Self-hosted, provider-agnostic,
        Git-native.
      </p>
      <div class="hero-cta-row">
        <CtaButton href="/get-started" variant="primary">
          Get started
        </CtaButton>
        <CtaButton href="https://github.com/edobry/minsky" variant="secondary" external>
          GitHub
        </CtaButton>
      </div>
    </div>
    <div class="hero-product">
      <ProductFrame>
        <Picture
          src={heroImage}
          alt="Real CLI output: a task's session lifecycle, from start through PR creation"
          formats={["avif", "webp"]}
          fallbackFormat="png"
          width={heroImage.width > 900 ? 900 : heroImage.width}
          densities={[1]}
          loading="eager"
        />
      </ProductFrame>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4.5rem 1.5rem 6rem;
    border-bottom: 1px solid color-mix(in oklch, var(--color-text-primary) 6%, transparent);
  }
  .hero-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: 4.5rem;
    }
    .hero {
      padding: 7rem 1.5rem 8rem;
    }
  }

  .hero-caption {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-headline {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 5.2vw, 4.25rem);
    font-weight: 500;
    line-height: 1.05;
    color: var(--color-text-primary);
    margin: 0;
  }

  .hero-sub {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 32rem;
    margin: 0;
  }

  .hero-concrete {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-subtle);
    max-width: 32rem;
    margin: 0;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .hero-product {
    width: 100%;
  }
</style>
