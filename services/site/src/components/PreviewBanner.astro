---
// Slim fixed banner shown on unpublished preview pages. Pair each variant
// page with `:global(body) { padding-top: ... }` in its own <style> block
// so the fixed banner doesn't cover the header below it.
interface Props {
  variant: "A" | "B" | "C";
}

const { variant } = Astro.props;
---

<div class="preview-banner" role="status">
  <p>Preview variant {variant} — not published</p>
</div>

<style>
  .preview-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-warn-amber);
  }
  .preview-banner p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--text-eyebrow--letter-spacing);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-bg-base);
  }
</style>
