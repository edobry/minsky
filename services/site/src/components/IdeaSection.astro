---
// The idea — section 3 of the home-page skeleton (mt#3827).
// Environmental alignment + the enforcement-hierarchy ladder
// (rules < skills < subagents < hooks), rendered plainly.

const ladder = [
  { label: "Rules", note: "Text. Read, or skipped, at will." },
  { label: "Skills", note: "A checklist an agent follows — still a choice." },
  { label: "Subagents", note: "Independent judgment, no stake in the outcome — a nudge, not a wall." },
  { label: "Hooks", note: "Run in the code path itself. Nothing to remember, nothing to skip." },
];
---

<section id="idea" class="content-section" aria-labelledby="idea-heading">
  <div class="content-inner">
    <p class="eyebrow">The idea</p>
    <h2 id="idea-heading" class="section-headline">Environment, not instruction.</h2>
    <div class="section-body">
      <p>
        Rules that live in a document are easy to write and easy to ignore — a paragraph in a
        style guide competes with a deadline, and the deadline usually wins, for an agent under
        pressure the same as for a person. The alternative is to put the rule where the work has
        to pass through it.
      </p>
      <p>
        A pre-commit hook that rejects an unformatted commit stops a human and an agent
        identically — there is no separate policy to remember, because there is nothing to
        remember. That is the shift: instead of asking agents to behave, build an environment
        where the well-behaved path is the only path through.
      </p>
      <p>Not every mechanism enforces equally hard:</p>
    </div>
    <ol class="ladder" aria-label="Enforcement strength, weakest to strongest">
      {
        ladder.map((step, i) => (
          <li class="ladder-step">
            <span class="ladder-index eyebrow">{String(i + 1).padStart(2, "0")}</span>
            <span class="ladder-label">{step.label}</span>
            <span class="ladder-note">{step.note}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .content-section {
    padding: 4.5rem 1.5rem;
    border-bottom: 1px solid color-mix(in oklch, var(--color-text-primary) 4%, transparent);
  }
  .content-inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .section-headline {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .section-body {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }
  .section-body p {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 42rem;
  }

  .ladder {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid color-mix(in oklch, var(--color-text-primary) 8%, transparent);
    border-radius: 8px;
    overflow: hidden;
  }
  .ladder-step {
    display: grid;
    grid-template-columns: 2.25rem auto;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid color-mix(in oklch, var(--color-text-primary) 6%, transparent);
    background-color: var(--color-bg-elevated);
  }
  .ladder-step:last-child {
    border-bottom: none;
    background-color: color-mix(in oklch, var(--color-bg-elevated) 60%, var(--color-signal) 6%);
  }
  .ladder-index {
    color: var(--color-signal);
    grid-row: 1 / span 2;
  }
  .ladder-label {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }
  .ladder-note {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    grid-column: 2;
  }
  @media (min-width: 640px) {
    .ladder-step {
      grid-template-columns: 2.25rem 10rem 1fr;
    }
    .ladder-note {
      grid-column: 3;
    }
  }
</style>
